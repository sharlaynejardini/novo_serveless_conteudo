{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ],
  "crons": [
    {
      "path": "/alertas/calendario-escolar",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/alertas/cronograma-envio-pebi",
      "schedule": "15 10 * * *"
    }
  ]
}
